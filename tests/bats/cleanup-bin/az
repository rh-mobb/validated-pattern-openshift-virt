#!/usr/bin/env python3
import json,os,pathlib,sys
args=sys.argv[1:]
with open(os.environ['CLEANUP_CALLS'],'a') as f:f.write('az '+' '.join(args)+'\n')
marker=pathlib.Path(os.environ['CLEANUP_CALLS']+'.deleted')
if args[:2]==['account','show']:
 print(json.dumps({'id':'wrong' if os.environ['CLEANUP_SCENARIO']=='wrong_subscription' else '00000000-0000-0000-0000-000000000004'}))
elif args[:3]==['netappfiles','volume','list']:
 print(json.dumps([] if marker.exists() else [{'id':'/subscriptions/00000000-0000-0000-0000-000000000004/resourceGroups/test-rg/providers/Microsoft.NetApp/netAppAccounts/test-anf/capacityPools/test-pool/volumes/pvc-123','provisioningState':'Succeeded'}]))
elif args[:3]==['netappfiles','volume','delete']:
 marker.touch()
else:sys.exit(1)
