 if s=='inventory_error':sys.exit(1)
 print(json.dumps({'items':[{'metadata':{'namespace':'test','name':'data'},'spec':{'storageClassName':'anf-virt'}}]}));sys.exit(0)
if args[:2]==['get','pods']:
 pods=[{'metadata':{'namespace':'test','name':'writer'},'spec':{'volumes':[{'persistentVolumeClaim':{'claimName':'data'}}]}}] if s=='consumer' else []
 print(json.dumps({'items':pods}));sys.exit(0)
if args[:2]==['get','pv']:
 print('{"items":[]}');sys.exit(0)
if args[:2]==['delete','bgproutings.networking.openshift.io'] and s=='bgp_error':sys.exit(1)
