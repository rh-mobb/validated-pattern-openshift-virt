#!/usr/bin/env bash
# Mock oc for sibling bats.
set -euo pipefail
cmd="${1:-}"
shift || true
case "${cmd}" in
  kustomize)
    cat <<'EOF'
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: virt-stack-gitops-controller
roleRef:
  kind: ClusterRole
  name: cluster-admin
---
apiVersion: v1
kind: Namespace
metadata:
  name: trident
---
apiVersion: operators.coreos.com/v1alpha1
kind: Subscription
metadata:
  name: trident-operator
  namespace: trident
spec:
  source: certified-operators
---
apiVersion: storage.k8s.io/v1
kind: StorageClass
metadata:
  name: anf-virt
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: trident-from-metadata
rules:
  - apiGroups: ["trident.netapp.io"]
    resources: ["tridentorchestrators"]
    verbs: ["get", "list", "patch", "update"]
  - apiGroups: ["apiextensions.k8s.io"]
    resources: ["customresourcedefinitions"]
    verbs: ["get", "list"]
---
apiVersion: operators.coreos.com/v1alpha1
kind: Subscription
metadata:
  name: kubevirt-hyperconverged
  namespace: openshift-cnv
spec:
  source: redhat-operators
---
apiVersion: shipwright.io/v1beta1
kind: Build
metadata:
  name: operator
---
apiVersion: shipwright.io/v1beta1
kind: BuildRun
metadata:
  name: operator-2b6ad939
---
apiVersion: operators.coreos.com/v1alpha1
kind: Subscription
metadata:
  name: openshift-pipelines-operator
  namespace: openshift-pipelines
spec:
  source: redhat-operators
---
apiVersion: operators.coreos.com/v1alpha1
kind: Subscription
metadata:
  name: openshift-builds-operator
  namespace: openshift-builds
spec:
  source: redhat-operators
---
apiVersion: batch/v1
kind: Job
metadata:
  name: bgp-from-metadata
EOF
    ;;
  get)
    if [[ "$*" == *"crd tridentbackendconfigs"* || "$*" == *"crd bgpcloudconfigurations"* ]]; then
      exit 1
    fi
    echo "mock oc get $*"
    ;;
  whoami)
    echo "system:admin"
    ;;
  *)
    echo "mock oc ${cmd} $*" >&2
    exit 0
    ;;
esac
