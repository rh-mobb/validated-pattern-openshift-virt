SHELL := /bin/bash
ROOT_DIR := $(abspath $(dir $(lastword $(MAKEFILE_LIST))))
TF_DIR := $(ROOT_DIR)/terraform
SCRIPTS := $(ROOT_DIR)/scripts
CLUSTER_PROFILE ?= $(error CLUSTER_PROFILE must be set)
CLUSTER_DIR := $(ROOT_DIR)/clusters/$(CLUSTER_PROFILE)
TFVARS := $(CLUSTER_DIR)/terraform.tfvars
TF_STATE := $(CLUSTER_DIR)/infrastructure.tfstate
export TFVARS
export CLUSTER := $(CLUSTER_PROFILE)
export TF_DATA_DIR := $(abspath $(CLUSTER_DIR)/.terraform)
unexport CLUSTER_NAME
ARO_HCP_ROOT ?=
ARO_HCP_PROFILE ?= $(CLUSTER_PROFILE)

.PHONY: check-tfvars init plan apply destroy cleanup bootstrap refresh-platform anf-preview anf-cleanup stack-ready smoke

check-tfvars:
	@test -f "$(TFVARS)" || (echo "Missing $(TFVARS)" >&2; exit 1)

refresh-platform:
	@if [ -n "$(ARO_HCP_ROOT)" ]; then \
		$(MAKE) -C "$(ARO_HCP_ROOT)" cluster.$(ARO_HCP_PROFILE).platform; \
	fi

init: check-tfvars
	terraform -chdir=$(TF_DIR) init -reconfigure -input=false \
		-backend-config="path=$(TF_STATE)"

plan: init refresh-platform
	terraform -chdir=$(TF_DIR) plan -var-file="$(TFVARS)"

apply: init refresh-platform
	terraform -chdir=$(TF_DIR) apply -auto-approve -var-file="$(TFVARS)"

anf-preview: init
	python3 $(SCRIPTS)/anf-volume-cleanup.py

anf-cleanup: init
	python3 $(SCRIPTS)/anf-volume-cleanup.py --apply

cleanup: init
	python3 $(SCRIPTS)/anf-volume-cleanup.py --drain

destroy: cleanup
	terraform -chdir=$(TF_DIR) destroy -auto-approve -var-file="$(TFVARS)"

bootstrap:
	@export TFVARS="$(TFVARS)"; \
	bash $(SCRIPTS)/gitops-bootstrap.sh

# Both targets use the installer's KUBECONFIG_PATH; they do not run Terraform.
SMOKE_STABLE_SECONDS ?= 120
SMOKE_TIMEOUT_SECONDS ?= 1800
SMOKE_BOOT_SOURCE ?= both

stack-ready:
	python3 $(SCRIPTS)/virt-smoke.py --ready-only --stable-seconds $(SMOKE_STABLE_SECONDS) --timeout $(SMOKE_TIMEOUT_SECONDS) --output-dir "$(CLUSTER_DIR)/logs/virt-smoke"

smoke:
	python3 $(SCRIPTS)/virt-smoke.py --stable-seconds $(SMOKE_STABLE_SECONDS) --timeout $(SMOKE_TIMEOUT_SECONDS) --boot-source $(SMOKE_BOOT_SOURCE) --output-dir "$(CLUSTER_DIR)/logs/virt-smoke"
